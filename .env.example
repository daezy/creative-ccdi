# These values are read at build time. Rebuild after changing them.
NEXT_PUBLIC_SITE_URL=https://creativecdi.org
NEXT_PUBLIC_ALLOW_INDEXING=true

# Optional ownership verification codes from the respective webmaster tools.
# Leave blank until the real codes are provided; do not enter account passwords.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Sanity public blog, read during the website build. No API token is needed.
SANITY_PROJECT_ID=z53lde5i
SANITY_DATASET=production
