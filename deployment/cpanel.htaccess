# CCDI static export, installed in creativecdi.org's document root.
# Use a valid TLS certificate before enabling these HTTPS redirects.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Leave certificate validation requests to the hosting provider.
  RewriteRule ^\.well-known/acme-challenge/ - [L]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^creativecdi\.org$ [NC]
  RewriteRule ^ https://creativecdi.org%{REQUEST_URI} [R=301,L,NE]
  # No SPA fallback: Next exports a real directory/index.html for each route.
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/png .png
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
