# CCDI static export, installed in creativecdi.org's document root.
# Use a valid TLS certificate before enabling these HTTPS redirects.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Leave certificate validation requests to the hosting provider.
  RewriteRule ^\.well-known/acme-challenge/ - [L]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^creativecdi\.org$ [NC]
  RewriteRule ^ https://creativecdi.org%{REQUEST_URI} [R=301,L,NE]
  # Deny hidden files/directories, keeping certificate validation accessible above.
  RewriteRule (^|/)\. - [F,L]
  # New Sanity slugs load the blog shell even if they did not exist at export.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/[a-z0-9]+(?:-[a-z0-9]+)*/?$ /blog/__live__/index.html [END]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/png .png
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Baseline CSP: keeps Next's static scripts and Google Maps working.
  # This is deliberately not a script-source allowlist.
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
