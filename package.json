{
  "name": "ccdi-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run generate:social",
    "generate:social": "node scripts/generate-social-assets.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:export": "node scripts/check-export.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "package:cpanel": "npm run check:export && npm run check:seo && python3 scripts/package-cpanel.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
